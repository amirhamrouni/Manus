{
  "name": "Logistics Live Tracking – Supabase + WhatsApp ETA",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "driver-tracking",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook",
      "name": "Webhook – Clappia Driver App",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "clappia-driver-tracking"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://{{ $vars.SUPABASE_PROJECT_REF }}.supabase.co/rest/v1/trucks?truck_id=eq.{{ $json.body.truck_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "specifyBody": "json",
        "jsonBody": "={\n  \"current_status\": \"{{ $json.body.status }}\",\n  \"latitude\": {{ $json.body.latitude }},\n  \"longitude\": {{ $json.body.longitude }},\n  \"speed_kmh\": {{ $json.body.speed_kmh }},\n  \"eta_minutes\": {{ $json.body.eta_minutes }},\n  \"last_updated_at\": \"{{ $now.toISO() }}\"\n}",
        "options": {}
      },
      "id": "node-supabase",
      "name": "Supabase – Update Truck",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $vars.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $vars.WHATSAPP_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $('Webhook – Clappia Driver App').item.json.body.customer_phone }}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"logistics_eta_update\",\n    \"language\": { \"code\": \"en_US\" },\n    \"components\": [\n      {\n        \"type\": \"body\",\n        \"parameters\": [\n          { \"type\": \"text\", \"text\": \"{{ $('Webhook – Clappia Driver App').item.json.body.customer_name }}\" },\n          { \"type\": \"text\", \"text\": \"{{ $('Webhook – Clappia Driver App').item.json.body.shipment_id }}\" },\n          { \"type\": \"text\", \"text\": \"{{ $('Webhook – Clappia Driver App').item.json.body.eta_minutes }} minutes\" },\n          { \"type\": \"text\", \"text\": \"{{ $('Webhook – Clappia Driver App').item.json.body.driver_name }}\" }\n        ]\n      }\n    ]\n  }\n}",
        "options": {}
      },
      "id": "node-whatsapp",
      "name": "WhatsApp – Send ETA to Customer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"truck_id\": \"{{ $('Webhook – Clappia Driver App').item.json.body.truck_id }}\",\n  \"timestamp\": \"{{ $now.toISO() }}\"\n}",
        "options": {}
      },
      "id": "node-respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [960, 300]
    }
  ],
  "connections": {
    "Webhook – Clappia Driver App": {
      "main": [
        [
          {
            "node": "Supabase – Update Truck",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Supabase – Update Truck": {
      "main": [
        [
          {
            "node": "WhatsApp – Send ETA to Customer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "WhatsApp – Send ETA to Customer": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "staticData": null,
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "id": "logistics-tracking-workflow-v2",
  "tags": ["logistics", "tracking", "whatsapp", "supabase"]
}
